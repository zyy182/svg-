@startuml
title PJ1 Phase 1 — TypeScript CLI SVG editor
skinparam componentStyle rectangle
package "src/cli" {
  component Cli
  component "CommandRegistry\n(command mapping)" as Registry
  component Tokenizer
}
package "src/application" {
  component DocumentSession
  component CommandHistory
  component "Command / EditCommand" as Commands
  component "Concrete commands" as Concrete
  interface DocumentStore
}
package "src/domain" {
  component Document
  component "Shape / Group / Leaves" as Shapes
  component "ShapeFactory\n(shape mapping)" as Factory
  component "ValueRules / AffineTransform" as Rules
}
package "src/infrastructure" {
  component SvgFileStore
  component "SvgCodec / SvgElement" as Codec
}
Cli --> Registry
Cli --> Tokenizer
Registry --> Concrete
Concrete --> Commands
Commands --> DocumentSession
DocumentSession --> CommandHistory
DocumentSession --> DocumentStore
DocumentSession --> Document
Concrete --> Factory
Factory --> Shapes
Document --> Shapes
Shapes --> Rules
SvgFileStore ..|> DocumentStore
SvgFileStore --> Codec
Codec --> Document
Codec --> Factory
note bottom of Registry
The two name-based mappings are explicit
Phase 2 refactoring points for providers.
end note
@enduml
